# 应用配置
APP_NAME=PenTip
APP_VERSION=1.0.0
APP_DESCRIPTION=基于 Electron 和 Vue 3的跨平台桌面应用，为创作者提供自动化和智能化创作。

# VITE 配置
VITE_BASE_URL=http://localhost:5173
VITE_TIMEOUT=30000

# 开发服务器配置
DEV_SERVER_PORT=3000
DEV_SERVER_HOST=localhost

# 生产服务器配置
SERVER_PORT=3000
SERVER_HOST=localhost

# 功能开关
FEATURE_AI_ASSISTANT=true
FEATURE_OFFLINE_MODE=false
FEATURE_AUTO_UPDATE=true

# 日志级别
LOG_LEVEL=info

# 注意：实际使用时请复制此文件为 .env 并修改相应配置