# 应用配置
APP_NAME=PenTip
APP_VERSION=1.0.0
APP_DESCRIPTION=基于 Electron 和 Vue 3的跨平台桌面应用，为创作者提供自动化和智能化创作。

# 数据库配置
SQLITE_DB_VERSION=1.0.0

# 开发环境配置
DEV_SERVER_PORT=3000
DEV_SERVER_HOST=localhost
DEV_VITE_HOST=localhost
DEV_VITE_PORT=5173

# 日志配置
LOG_LEVEL=debug  # 日志级别，默认info
LOG_DIR=logs    # 日志目录，默认logs
LOG_MAX_SIZE=10m  # 日志文件最大大小，默认10m
LOG_MAX_FILES=5  # 日志文件最大数量，默认5
LOG_SPLIT_BY_DATE=true  # 日志按日期分割，默认启用
LOG_FORMAT=text  # 日志格式，默认text
LOG_CONSOLE=true  # 控制台输出日志，非生产环境默认启用，生产环境禁用
LOG_FILE=true  # 文件输出日志，默认启用
LOG_TIMESTAMP=true  # 日志包含时间戳，默认启用
LOG_COLORIZE=true  # 控制台日志彩色输出，默认启用
LOG_KEEP_DAYS=30  # 日志保留天数，默认30天

# 注意：实际使用时请复制此文件为 .env 并修改相应配置