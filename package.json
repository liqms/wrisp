{
  "name": "pentip",
  "private": true,
  "version": "1.0.0",
  "description": "Pentip - 基于Electron和Vue 3的跨平台桌面应用",
  "type": "module",
  "author": "iclassink",
  "license": "AGPL-3.0",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vue-tsc && vite build",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "prod": "vite build && electron-builder",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "typecheck": "vue-tsc --noEmit",
    "clean": "del /Q /S dist-renderer dist-electron release node_modules\\.vite"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "pinia": "^3.0.4",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.6",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^10.0.0",
    "typescript": "^6.0.2",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.5",
    "vite-plugin-vue-mcp": "^0.3.2",
    "vue-tsc": "^2.0.27"
  },
  "build": {
    "appId": "com.pentip.app",
    "productName": "PenTip",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "pkg"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ]
    }
  }
}
