{
  "name": "wrisp",
  "version": "0.1.3",
  "description": "Crisp writing, pure soul.",
  "type": "commonjs",
  "author": "Wrisp Team",
  "homepage": "https://trywrisp.com",
  "email": "liqms@msn.cn",
  "license": "AGPL-3.0",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vue-tsc && vite build",
    "start": "electron .",
    "bump": "node scripts/bump-version.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "prod": "vite build && electron-builder",
    "lint": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "clean": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force dist-renderer, dist-electron, release -ErrorAction SilentlyContinue; exit 0\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@lancedb/lancedb": "^0.27.2",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-bubble-menu": "^3.27.3",
    "@tiptap/extension-code-block-lowlight": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/html": "^3.23.4",
    "@tiptap/markdown": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@tiptap/vue-3": "^3.23.4",
    "@vicons/ionicons5": "^0.13.0",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "apache-arrow": "^21.1.0",
    "archiver": "^8.0.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.9.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.4",
    "naive-ui": "^2.44.1",
    "openai": "^6.39.1",
    "pinia": "^3.0.4",
    "turndown": "^7.2.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.1",
    "vue-router": "^5.0.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vicons/material": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "dotenv": "^17.4.1",
    "electron": "41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.10.3",
    "sass-embedded": "^1.99.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.6"
  },
  "build": {
    "appId": "com.wrisp.app",
    "productName": "Wrisp",
    "npmRebuild": false,
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "liqms",
      "repo": "wrisp"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "static/wrisp.png"
    },
    "mac": {
      "icon": "static/wrisp.png",
      "target": [
        "dmg",
        "pkg"
      ]
    },
    "linux": {
      "icon": "static/wrisp.png",
      "maintainer": "Wrisp Team <liqms@msn.cn>",
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
